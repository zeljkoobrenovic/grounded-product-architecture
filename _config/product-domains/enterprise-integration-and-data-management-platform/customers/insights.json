    {
      "id": "insi-01",
      "title": "Managed outcome is the commercial center",
      "summary": "Enable U packages design, implementation, security, monitoring and lifecycle operation as Managed Integrations with dashboards and predictable monthly costs.",
      "implication": "Model the control plane, service management and reusable catalog as first-class products, not support wrapped around middleware.",
      "priority": "high",
      "tags": [
        "managed-services",
        "recurring-revenue"
      ],
