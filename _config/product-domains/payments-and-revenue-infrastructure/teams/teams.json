{
  "orgDesign": {
    "domainId": "payments-and-revenue-infrastructure",
    "domainName": "Payments and Revenue Infrastructure",
    "companyProfile": "Programmable financial infrastructure company serving merchants, recurring-revenue businesses, and platforms through payments, billing, connect, risk, and finance operations products.",
    "operatingModel": "Payments teams own checkout, payment methods, and authorization loops. Revenue automation teams own pricing, usage billing, tax, and accounting outputs. Connect teams own onboarding, funds routing, and payouts. Shared trust and platform teams own fraud, ledgering, reconciliation, APIs, and reporting.",
    "teamTypes": [
      {
        "id": "stream-aligned",
        "name": "Stream-aligned",
        "color": "#2563eb",
        "description": "Aligned to a product, service, or customer journey; owns end-to-end delivery and outcomes."
      },
      {
        "id": "platform",
        "name": "Platform",
        "color": "#0891b2",
        "description": "Provides reusable capabilities, services, or infrastructure to multiple stream-aligned teams."
      },
      {
        "id": "enabling",
        "name": "Enabling",
        "color": "#16a34a",
        "description": "Helps stream-aligned teams overcome obstacles, adopt technologies, or improve practices."
      },
      {
        "id": "complicated-subsystem",
        "name": "Complicated subsystem",
        "color": "#9333ea",
        "description": "Owns a complex subsystem that requires specialized knowledge and skills."
      },
      {
        "id": "other",
        "name": "Other",
        "color": "#6b7280",
        "description": "Does not fit the other categories (e.g. a temporary or cross-functional team)."
      }
    ],
    "teamDependencyTypes": [
      {
        "id": "collaboration",
        "name": "Collaboration",
        "description": "Working closely together with another team."
      },
      {
        "id": "x-as-a-service",
        "name": "X-as-a-Service",
        "description": "Consuming or providing something with minimal collaboration."
      },
      {
        "id": "facilitating",
        "name": "Facilitating",
        "description": "Helping (or being helped by) another team to clear impediments."
      },
      {
        "id": "other",
        "name": "Other",
        "description": "Any other type of dependency not covered above."
      }
    ]
  },
