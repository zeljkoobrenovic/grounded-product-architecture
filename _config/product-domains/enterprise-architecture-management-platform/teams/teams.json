{
  "orgDesign": {
    "domainId": "enterprise-architecture-management-platform",
    "domainName": "Enterprise Architecture Management Platform",
    "companyProfile": "Enterprise transformation SaaS platform serving CIOs, enterprise architecture teams, transformation offices, risk leaders, application owners, and business stakeholders through living architecture models, portfolio intelligence, roadmaps, governance, and AI-assisted insight.",
    "operatingModel": "Platform teams own the architecture graph, integrations, analytics, governance, collaboration, and AI foundations. Stream-aligned product teams own customer-visible workspaces for portfolio optimization, roadmapping, solution governance, and stakeholder engagement.",
    "designPrinciples": [
      "Keep metamodel, repository, and model quality together because customers judge architecture trust as one foundation.",
      "Keep application portfolio and analytics close because rationalization decisions require cost, risk, lifecycle, and dependency evidence in one loop.",
      "Keep roadmap and investment planning close to scenario analytics because transformation confidence depends on tradeoff visibility.",
      "Keep governance, controls, evidence, and security operations tightly aligned because regulated buyers need defensible decision trails.",
      "Keep collaboration and AI insight together because broad stakeholder adoption depends on simpler contribution and explanation."
    ],
    "staffingPrinciple": "Prefer teams of roughly 6-9 FTE with clear product brick ownership and named dependencies.",
    "groupingPrinciple": "Use top-level groups for knowledge graph foundation, portfolio intelligence, transformation planning, and engagement and trust.",
    "groupLeadershipPrinciple": "Use cross-group leadership around architecture data trust, portfolio value, roadmap confidence, governance evidence, and stakeholder adoption."
  },
