{
  "orgDesign": {
    "domainId": "enterprise-architecture-management-platform",
    "domainName": "Enterprise Architecture Management Platform",
    "companyProfile": "Enterprise transformation SaaS platform serving CIOs, enterprise architecture teams, transformation offices, risk leaders, application owners, and business stakeholders through living architecture models, portfolio intelligence, roadmaps, governance, and AI-assisted insight.",
