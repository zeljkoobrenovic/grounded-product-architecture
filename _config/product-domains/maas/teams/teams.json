{
  "orgDesign": {
    "domainId": "maas",
    "domainName": "MaaS",
    "companyProfile": "Global urban-mobility platform business combining parking, transport payments, business mobility, city intelligence, partner ecosystem, and automotive-data services. The domain is modeled as a network of focused teams sized around 8-11 FTE.",
    "operatingModel": "Value-stream teams own parking, transit, city, fleet, and partner outcomes while platform teams provide identity, integration, ledger, workflow, data, and reliability capabilities reused across all business lines.",
    "teamTypes": [
      {
        "id": "stream-aligned",
        "name": "Stream-aligned",
        "color": "#2563eb",
        "description": "Aligned to a product, service, or customer journey; owns end-to-end delivery and outcomes."
      },
      {
        "id": "platform",
        "name": "Platform",
        "color": "#0891b2",
        "description": "Provides reusable capabilities, services, or infrastructure to multiple stream-aligned teams."
      },
      {
        "id": "enabling",
        "name": "Enabling",
        "color": "#16a34a",
        "description": "Helps stream-aligned teams overcome obstacles, adopt technologies, or improve practices."
      },
      {
        "id": "complicated-subsystem",
        "name": "Complicated subsystem",
        "color": "#9333ea",
        "description": "Owns a complex subsystem that requires specialized knowledge and skills."
      },
      {
        "id": "other",
        "name": "Other",
        "color": "#6b7280",
        "description": "Does not fit the other categories (e.g. a temporary or cross-functional team)."
      }
    ],
    "teamDependencyTypes": [
      {
        "id": "collaboration",
        "name": "Collaboration",
        "description": "Working closely together with another team."
      },
      {
        "id": "x-as-a-service",
        "name": "X-as-a-Service",
        "description": "Consuming or providing something with minimal collaboration."
      },
      {
        "id": "facilitating",
        "name": "Facilitating",
        "description": "Helping (or being helped by) another team to clear impediments."
      },
      {
        "id": "other",
        "name": "Other",
        "description": "Any other type of dependency not covered above."
      }
    ]
  },
