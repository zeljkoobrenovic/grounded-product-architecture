    "domainId": "internet-number-registry-and-routing-trust",
    "domainName": "Internet Number Registry and Routing Trust",
    "companyProfile": "Not-for-profit regional Internet registry and critical Internet infrastructure operator serving members, operators, researchers, policymakers, and the wider Internet community.",
    "operatingModel": "Stream-aligned groups own registry, member/governance, routing trust/DNS, and public measurement/data loops, with explicit coordination around security, policy impact, and public-service reliability.",
    "designPrinciples": [
      "Keep registry stewardship close to member workflows.",
      "Keep routing security and DNS authority under critical-infrastructure operating discipline.",
      "Keep public data provenance and API stability explicit.",
      "Keep policy implementation connected to affected product workflows."
    ],
    "staffingPrinciple": "Prefer durable teams of roughly 7-10 FTE with clear product-brick ownership and shared on-call expectations where services are critical.",
    "groupingPrinciple": "Use top-level groups that mirror the product-brick domains.",
    "groupLeadershipPrinciple": "Use cross-group leadership for registry trust, critical infrastructure resilience, public data stewardship, and policy implementation."
