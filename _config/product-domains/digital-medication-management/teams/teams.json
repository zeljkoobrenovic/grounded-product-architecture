      {
        "id": "stream-aligned",
        "name": "Stream-aligned",
        "color": "#2563eb",
        "description": "Owns a customer or value stream end to end."
      },
      {
        "id": "platform",
        "name": "Platform",
        "color": "#0891b2",
        "description": "Provides internal products and capabilities other teams build on."
      },
      {
        "id": "enabling",
        "name": "Enabling",
        "color": "#16a34a",
        "description": "Uplifts other teams in a specialist area such as safety and compliance."
      },
      {
        "id": "complicated-subsystem",
        "name": "Complicated subsystem",
        "color": "#9333ea",
        "description": "Owns a deep specialist subsystem such as the dispensing mechanism or scheduling."
      },
      {
        "id": "other",
        "name": "Other",
        "color": "#6b7280",
        "description": "Temporary or cross-functional teams."
      }
