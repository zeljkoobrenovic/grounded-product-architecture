  "orgDesign": {
    "domainId": "digital-medication-management",
    "domainName": "Digital Medication Management",
    "companyProfile": "A European leader in automated medicine dispensing and remote medication management for home care and supported living, selling a regulated managed service to municipalities, care providers, and pharmacies.",
