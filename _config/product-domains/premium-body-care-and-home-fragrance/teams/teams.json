{
  "orgDesign": {
    "domainId": "premium-body-care-and-home-fragrance",
    "domainName": "Premium Body Care and Home Fragrance",
    "companyProfile": "Premium omnichannel beauty and wellbeing business centered on body care, bath, home fragrance, refillable products, seasonal gifting, loyalty, and advisor-led retail.",
    "operatingModel": "Customer growth teams own discovery, gifting, loyalty, and replenishment. Commerce operations teams own checkout, payments, inventory, fulfillment, and care. Brand and channel foundation teams own advisor tooling, product launch governance, compliance, data, consent, identity, and measurement.",
    "designPrinciples": [
      "Keep scent discovery and gifting close together because both depend on confidence, sensory education, and occasion context.",
      "Keep loyalty, replenishment, refills, and personalization in one loop because routine continuity is the strongest retention driver.",
      "Keep checkout, payment, inventory, and fulfillment ownership explicit because premium gifting fails when promises are unreliable.",
      "Treat store advisors as product users with their own tooling, data, and operating metrics.",
      "Keep product launch, formula evidence, sourcing, and claims governance together so customer-facing claims remain defensible."
    ],
    "staffingPrinciple": "Prefer stream-aligned teams of roughly 7-10 FTE for customer-facing loops and platform teams of 6-9 FTE for shared data, compliance, and runtime responsibilities.",
    "groupingPrinciple": "Use top-level groups for customer growth, commerce operations, and brand/channel foundations.",
    "groupLeadershipPrinciple": "Group leads own cross-team tradeoffs on customer confidence, member retention, operational reliability, and launch governance."
  },
