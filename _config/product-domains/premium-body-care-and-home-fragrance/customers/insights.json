  "items": [
    {
      "id": "pbhf-01",
      "title": "The domain is best modeled as an omnichannel premium routine and gifting business",
      "summary": "Rituals, L'OCCITANE, Molton Brown, Bath & Body Works, and Lush all combine stores, ecommerce, seasonal merchandising, gifting, and brand storytelling rather than operating as pure ecommerce catalogs.",
      "implication": "Model discovery, gifting, store assistance, availability, fulfillment, and customer profile continuity together.",
      "priority": "high",
      "tags": [
        "omnichannel",
        "business-model"
      ],
      "sourceIds": [
        "rituals-business-highlights",
        "loccitane-who-we-are",
