      "id": "pbhf-03",
      "title": "Scent confidence requires product data, content, sampling, and human advice",
      "summary": "Premium body care and home fragrance purchases are sensory, personal, and often gifted; customers need scent notes, ingredients, reviews, advisor context, and sampling paths to lower choice risk.",
      "implication": "Treat recommendations, product catalog claims, content, reviews, sampling, and clienteling as connected confidence-building capabilities.",
      "priority": "high",
      "tags": [
        "scent-discovery",
        "confidence"
      ],
