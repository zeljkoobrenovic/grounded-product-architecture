    {
      "id": "insight-ai-infrastructure-demand",
      "title": "AI infrastructure demand is reshaping cloud competition",
      "summary": "Hyperscalers and specialist data platforms all frame growth around AI infrastructure, model services, data platforms, or enterprise AI adoption. Customers now evaluate cloud data platforms for accelerator capacity, model roadmap, data gravity, and production controls, not just generic compute or storage breadth.",
      "implication": "Treat AI capacity, model access, and production governance as one adoption journey with visible ownership across compute, model runtime, catalog, safety, and FinOps teams.",
      "priority": "high",
      "tags": [
        "ai-infrastructure",
        "capacity",
        "competitive-dynamics",
        "production-ai"
      ],
      "sourceIds": [
