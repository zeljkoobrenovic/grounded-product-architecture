    {
      "id": "insight-finops-must-include-ai-units",
      "title": "FinOps has to move from cloud bills to AI unit economics",
      "summary": "Training jobs, inference endpoints, accelerator pools, warehouse queries, and storage all create different cost shapes. A single cloud bill view is too late and too coarse for teams trying to scale AI features responsibly.",
      "implication": "Expose unit cost by workload, model, feature, query path, and customer-facing AI journey before spend reaches finance review.",
      "priority": "high",
      "tags": [
        "finops",
